# Copy to .env and fill the three IAM fields for unattended local login.
MONITOR_IAM_TENANT=
MONITOR_IAM_USERNAME=
MONITOR_IAM_PASSWORD=
MONITOR_INTERVAL=60
MONITOR_BROWSER_CHANNEL=auto
MONITOR_WORKSPACE=/subscriptions/a14649f0-2e3e-4a08-91ca-5a7e435d7ada/resourceGroups/default/zones/ms-sc-01z/workspaces/modeltoolchain

# SenseCore IAM account (same local-only handling).
SENSECORE_IAM_TENANT=
SENSECORE_IAM_USERNAME=
SENSECORE_IAM_PASSWORD=

# Optional desktop-only CCI VS Code: existing verified SSH jump-host aliases.
# These hosts must reach the CCI private instance IP; IAM still selects the exact container.
MONITOR_CCI_IDE_SSH_HOST=maoshanwangtech
SENSECORE_CCI_IDE_SSH_HOST=sensecore
