{
  "name": "workspace-appearance",
  "displayName": "iLab Workspace Appearance",
  "description": "Editor appearance and scoped Codex file, folder and selection references.",
  "version": "1.4.0",
  "publisher": "ilab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "ilab-material-icons",
        "label": "iLab Material Icons",
        "path": "./icons.json"
      }
    ],
    "configurationDefaults": {
      "workbench.iconTheme": "ilab-material-icons",
      "editor.fontFamily": "'iLab JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, monospace",
      "editor.fontSize": 14,
      "editor.fontWeight": "400",
      "editor.lineHeight": 24,
      "editor.fontLigatures": true,
      "editor.padding.top": 14,
      "editor.padding.bottom": 14,
      "editor.minimap.enabled": false,
      "editor.renderWhitespace": "selection",
      "editor.guides.bracketPairs": true,
      "editor.bracketPairColorization.enabled": true,
      "workbench.tree.indent": 18,
      "workbench.tree.renderIndentGuides": "onHover",
      "explorer.compactFolders": false,
      "breadcrumbs.enabled": true,
      "workbench.list.smoothScrolling": true,
      "terminal.integrated.fontFamily": "'iLab JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, monospace",
      "terminal.integrated.fontSize": 13,
      "workbench.colorCustomizations": {
        "[Default Dark Modern]": {
          "editor.background": "#182025",
          "editor.foreground": "#dce5e9",
          "editor.lineHighlightBackground": "#202b31",
          "editorLineNumber.foreground": "#627984",
          "editorLineNumber.activeForeground": "#b5cecc",
          "editorCursor.foreground": "#8bd8bd",
          "editorIndentGuide.background1": "#2d3b42",
          "editorIndentGuide.activeBackground1": "#537569",
          "editor.selectionBackground": "#34574b88",
          "sideBar.background": "#141b20",
          "sideBar.foreground": "#bfcdd2",
          "sideBarSectionHeader.background": "#1d272d",
          "activityBar.background": "#10171b",
          "activityBar.activeBorder": "#7cd2af",
          "activityBar.foreground": "#a7ddc8",
          "list.activeSelectionBackground": "#28483d",
          "list.activeSelectionForeground": "#ecf6f0",
          "list.hoverBackground": "#213039",
          "editorGroupHeader.tabsBackground": "#141b20",
          "tab.activeBackground": "#182025",
          "tab.activeBorderTop": "#7cd2af",
          "statusBar.background": "#1b3e33",
          "statusBar.foreground": "#d2eee2",
          "statusBar.noFolderBackground": "#182c26",
          "panel.background": "#141b20",
          "panel.border": "#2a3b40",
          "titleBar.activeBackground": "#11191e",
          "focusBorder": "#6dbb9c"
        },
        "[Dark Modern]": {
          "editor.background": "#182025",
          "editor.foreground": "#dce5e9",
          "editor.lineHighlightBackground": "#202b31",
          "editorLineNumber.foreground": "#627984",
          "editorLineNumber.activeForeground": "#b5cecc",
          "editorCursor.foreground": "#8bd8bd",
          "editorIndentGuide.background1": "#2d3b42",
          "editorIndentGuide.activeBackground1": "#537569",
          "editor.selectionBackground": "#34574b88",
          "sideBar.background": "#141b20",
          "sideBar.foreground": "#bfcdd2",
          "sideBarSectionHeader.background": "#1d272d",
          "activityBar.background": "#10171b",
          "activityBar.activeBorder": "#7cd2af",
          "activityBar.foreground": "#a7ddc8",
          "list.activeSelectionBackground": "#28483d",
          "list.activeSelectionForeground": "#ecf6f0",
          "list.hoverBackground": "#213039",
          "editorGroupHeader.tabsBackground": "#141b20",
          "tab.activeBackground": "#182025",
          "tab.activeBorderTop": "#7cd2af",
          "statusBar.background": "#1b3e33",
          "statusBar.foreground": "#d2eee2",
          "statusBar.noFolderBackground": "#182c26",
          "panel.background": "#141b20",
          "panel.border": "#2a3b40",
          "titleBar.activeBackground": "#11191e",
          "focusBorder": "#6dbb9c"
        }
      },
      "workbench.colorTheme": "Dark Modern",
      "chat.disableAIFeatures": true,
      "chatgpt.openOnStartup": true,
      "files.watcherExclude": {
        "**/.venv/**": true,
        "**/.venv-*/**": true,
        "**/venv/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/*.{safetensors,ckpt,pt,pth,onnx}": true
      },
      "search.exclude": {
        "**/.venv/**": true,
        "**/.venv-*/**": true,
        "**/venv/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/*.{safetensors,ckpt,pt,pth,onnx}": true
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "ilab.codex.addReference",
          "group": "codex@1",
          "when": "(resourceScheme == file || resourceScheme == vscode-remote) && !explorerResourceIsFolder"
        },
        {
          "command": "ilab.codex.addFolderReference",
          "group": "codex@1",
          "when": "(resourceScheme == file || resourceScheme == vscode-remote) && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "submenu": "ilab.codex.context",
          "group": "codex@2",
          "when": "(resourceScheme == file || resourceScheme == vscode-remote)"
        }
      ],
      "ilab.codex.context": [
        {
          "command": "ilab.codex.addSelectionReference",
          "group": "scope@1",
          "when": "editorHasSelection"
        },
        {
          "command": "ilab.codex.addFileReference",
          "group": "scope@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ilab.codex.addFolderReference",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "ilab.codex.addReference",
        "title": "添加引用到 Codex（优先选中代码）",
        "category": "Codex"
      },
      {
        "command": "ilab.codex.addFileReference",
        "title": "引用文件到 Codex",
        "category": "Codex"
      },
      {
        "command": "ilab.codex.addFolderReference",
        "title": "引用文件夹到 Codex",
        "category": "Codex"
      },
      {
        "command": "ilab.codex.addSelectionReference",
        "title": "仅引用选中代码到 Codex",
        "category": "Codex"
      }
    ],
    "submenus": [
      {
        "id": "ilab.codex.context",
        "label": "Codex：添加引用"
      }
    ]
  },
  "main": "./context.js"
}
